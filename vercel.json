{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node scripts/vercel-install.js",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,mock-db.json}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
